RewriteEngine On
RewriteBase /EL-ROI/

# Dashboard
RewriteRule ^dashboard/?$ dashboard/overview.php [L,QSA]

# Jobs
RewriteRule ^jobs/?$ jobs/browse_jobs.php [L,QSA]

# My Jobs
RewriteRule ^my-jobs/?$ jobs/my_jobs.php [L,QSA]

# Job Details
RewriteRule ^job/([0-9]+)/?$ jobs/view_job.php?job_id=$1 [L,QSA]

# Student Profile
RewriteRule ^student-profile/?$ profile/student-profile-setup.php [L,QSA]

# Lecturer Profile
RewriteRule ^lecturer-profile/?$ profile/lecturer-profile-setup.php [L,QSA]

# Login
RewriteRule ^login/?$ auth/login.php [L,QSA]

# Company Login
RewriteRule ^company-login/?$ auth/company_login.php [L,QSA]

# Logout
RewriteRule ^logout/?$ auth/logout.php [L,QSA]